node_modules/
.DS_Store
*.log
.env
.env.*
!.env.example

# Per-project working state: the sheet specs and the choices they wrote back.
.stet/*
!.stet/sources.json
!.stet/standing.json

# Scratch directory for the development process itself, not part of the shipped project.
.superpowers/

# Design tool state: mock renders, hook cache, review notes. Local working material, and 31MB of
# PNGs that a public repo would carry forever. The config is the exception: it carries the design
# detector's ignore list, which is a decision with a stated reason and belongs with the code it
# exempts. config.local.json is the per-developer override and stays out.
.impeccable/*
!.impeccable/config.json

# npm pack output.
*.tgz
